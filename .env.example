# Anna AI Environment Configuration
# Copy this file to .env and update values for your environment

# Ollama Configuration
OLLAMA_ENDPOINT=http://localhost:11434

# Logging
LOG_LEVEL=INFO

# Phase 3: Database Configuration (PostgreSQL)
# Only needed if running with --profile phase3 in docker-compose
DATABASE_URL=postgresql://anna:password@localhost:5432/anna_ai

# Phase 3: Redis Configuration (Message Queue)
# Only needed if running with --profile phase3 in docker-compose
REDIS_URL=redis://localhost:6379/0

# Voice and TTS Settings
TTS_BACKEND=pyttsx3
TTS_VOICE_INDEX=0
TTS_SPEED=150
TTS_VOLUME=0.8

# Discord Integration (optional)
DISCORD_TOKEN=your_discord_bot_token_here

# Twitch Integration (optional)
TWITCH_TOKEN=your_twitch_bot_token_here
TWITCH_USERNAME=your_twitch_username

# YouTube Integration (optional)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Agent Configuration
AGENT_NAME=Anna
USER_NAME=User

# Memory Settings
MAX_SHORT_TERM_MEMORIES=100
MAX_MEDIUM_TERM_MEMORIES=500
MAX_LONG_TERM_SUMMARIES=365

# Processing Settings
COGNITIVE_LOOP_SPEED=medium
RESPONSE_RATE_LIMIT_SECONDS=5
MAX_THOUGHT_BUFFER_SIZE=200

# Debug Settings
DEBUG=false
VERBOSE_LOGGING=false
