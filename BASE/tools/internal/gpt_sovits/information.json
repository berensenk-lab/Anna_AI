{
  "tool_name": "gpt_sovits",
  "tool_description": "High-quality neural voice synthesis using GPT-SoVITS with streaming and Voice Hub support",
  "category": "internal",
  "service_type": "tts",
  "control_variable_name": "USE_GPT_SOVITS",
  "control_logic": "enabled_when_true",
  "version": "2.0.0",
  "priority": 15,
  "requirements": {
    "gpu_recommended": true,
    "voice_sample_required": true,
    "min_vram_gb": 6,
    "cuda_required": false,
    "python_packages": [
      "torch",
      "sounddevice",
      "soundfile",
      "numpy"
    ]
  },
  "features": {
    "voice_cloning": true,
    "streaming": true,
    "voice_hub": true,
    "emotional_control": true,
    "multi_language": true,
    "low_latency": true,
    "caching": true,
    "real_time_streaming": true
  },
  "configuration": {
    "voice_sample_path": "./personality/voice/{agentname}_voice_sample.wav",
    "sovits_model": "models/gpt_sovits/s2G488k.pth",
    "gpt_model": "models/gpt_sovits/s1bert25hz-2kh-longer-epoch=68e-step=50232.ckpt",
    "language": "en",
    "speed": 1.0,
    "device": "auto",
    "cache_max_entries": 50
  }
}